{
  "manifest_version": 3,
  "name": "Field Day",
  "version": "1.0.0",
  "description": "Fill and submit web forms with realistic test data. Handles multi-step forms and conditional fields, and pauses for CAPTCHAs.",
  "homepage_url": "https://r3hab-media.github.io/field-day/",
  "permissions": ["contextMenus", "scripting", "activeTab", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Field Day: fill a form on this page",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
